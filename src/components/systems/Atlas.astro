---
import "../../styles/systems.css";

type Item = { src: string; alt: string; title: string; text: string; view: string };
type Props = { items: Item[] };
const { items } = Astro.props;
---

<div class="not-prose sys-block sys-atlas">
  {items.map((item) => (
    <figure>
      <div class="sys-frame">
        <a class="sys-zoom" href={item.src} target="_blank" rel="noopener" title="Open full size">
          <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
          <span class="sys-zoom-badge" aria-hidden="true">⤢</span>
          <span class="sr-only">(opens full size in a new tab)</span>
        </a>
      </div>
      <h4>{item.title}</h4>
      <p>{item.text}</p>
      <button type="button" class="sys-open" data-open-view={item.view}>Open in 3D ↑</button>
    </figure>
  ))}
</div>
