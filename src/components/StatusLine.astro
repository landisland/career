---
import type { TimelineEntry } from "@types";

type Props = { entry?: TimelineEntry };
const { entry } = Astro.props;
---

{entry && (
  <div class="status text-sm">
    <span class="pulse" aria-hidden="true" />
    <span>{entry.focus} at {entry.org}</span>
  </div>
)}

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: rgb(34 197 94);
    flex: none;
  }
  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgb(34 197 94);
    animation: breathe 3s ease-out infinite;
  }
  @keyframes breathe {
    0% { transform: scale(1); opacity: 0.4; }
    60%, 100% { transform: scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse::after { animation: none; }
  }
</style>
