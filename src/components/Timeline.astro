---
import type { TimelineEntry } from "@types";

type Props = {
  entries: TimelineEntry[];
  showHighlights?: boolean;
};

const { entries, showHighlights = false } = Astro.props;
---

<ol class="timeline">
  {entries.map((entry) => (
    <li class="timeline-item">
      <span
        class:list={["dot", entry.current && "dot-current"]}
        aria-hidden="true"
      />
      <div class="flex flex-wrap items-baseline justify-between gap-x-3">
        <div class="font-semibold text-black dark:text-white">
          {entry.company}
        </div>
        <div class="text-sm tabular-nums">
          {entry.period}
        </div>
      </div>
      <div class="text-sm">
        {entry.team}
        {entry.current && (
          <span class="now-badge">now</span>
        )}
      </div>
      <p class="mt-2 font-serif text-[15px] leading-relaxed">
        {entry.summary}
      </p>
      {showHighlights && entry.highlights && (
        <ul class="mt-2 list-disc pl-5 font-serif text-[15px] leading-relaxed space-y-1">
          {entry.highlights.map((h) => <li>{h}</li>)}
        </ul>
      )}
      {showHighlights && (
        <div class="mt-1 text-xs opacity-75">{entry.location}</div>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    margin-left: 6px;
    border-left: 1px solid rgb(0 0 0 / 0.15);
  }
  :global(.dark) .timeline {
    border-left-color: rgb(255 255 255 / 0.2);
  }
  .timeline-item {
    position: relative;
    padding-left: 24px;
    padding-bottom: 28px;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .dot {
    position: absolute;
    left: -6px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: rgb(245 245 244); /* stone-100, matches page bg */
    border: 2px solid rgb(168 162 158); /* stone-400 */
  }
  :global(.dark) .dot {
    background: rgb(28 25 23); /* stone-900 */
    border-color: rgb(120 113 108); /* stone-500 */
  }
  .dot-current,
  :global(.dark) .dot-current {
    background: rgb(34 197 94); /* green-500 */
    border-color: rgb(34 197 94);
  }
  .dot-current::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    background: rgb(34 197 94);
    animation: breathe 2.4s ease-out infinite;
  }
  @keyframes breathe {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(2.6);
      opacity: 0;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-current::after {
      animation: none;
    }
  }
  .now-badge {
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(21 128 61); /* green-700 */
    background: rgb(34 197 94 / 0.12);
  }
  :global(.dark) .now-badge {
    color: rgb(134 239 172); /* green-300 */
    background: rgb(34 197 94 / 0.18);
  }
</style>
