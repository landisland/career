---
import type { TimelineEntry } from "@types";

type Props = {
  entries: TimelineEntry[];
  showHighlights?: boolean;
  showSummary?: boolean;
};

const { entries, showHighlights = false, showSummary = true } = Astro.props;
---

<ol class:list={["timeline", !showSummary && "timeline-compact"]}>
  {entries.map((entry) => (
    <li class="timeline-item">
      <span
        class:list={["dot", entry.current && "dot-current"]}
        aria-hidden="true"
      />
      <div class="flex flex-wrap items-baseline justify-between gap-x-3">
        <div class="font-semibold text-black">
          {entry.focus}
        </div>
        <div class="text-sm tabular-nums">
          {entry.period}
        </div>
      </div>
      <div class="text-sm">
        {[entry.org, entry.title].filter(Boolean).join(" · ")}
        {showHighlights && <span class="opacity-60">{" · "}{entry.location}</span>}
      </div>
      {showSummary && (
        <p class="mt-2 font-serif text-[15px] leading-relaxed">
          {entry.summary}
        </p>
      )}
      {showHighlights && entry.highlights && (
        <ul class="mt-2 list-disc pl-5 font-serif text-[15px] leading-relaxed space-y-1">
          {entry.highlights.map((h) => <li>{h}</li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    margin-left: 4px;
    border-left: 1px solid rgb(0 0 0 / 0.12);
  }
  .timeline-item {
    position: relative;
    padding-left: 22px;
    padding-bottom: 28px;
  }
  .timeline-compact .timeline-item {
    padding-bottom: 16px;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .dot {
    position: absolute;
    left: -4px;
    top: 8px;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: rgb(168 162 158); /* stone-400 */
  }
  .dot-current {
    background: rgb(34 197 94); /* green-500 */
  }
  .dot-current::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgb(34 197 94);
    animation: breathe 3s ease-out infinite;
  }
  @keyframes breathe {
    0% { transform: scale(1); opacity: 0.4; }
    60%, 100% { transform: scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot-current::after { animation: none; }
  }
</style>
