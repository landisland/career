---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import Timeline from "@components/Timeline.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { TIMELINE } from "@data/timeline";
import { PROJECTS } from "@data/projects";

const posts = (await getCollection("blog"))
  .filter(post => import.meta.env.DEV || !post.data.draft) // drafts show on localhost only
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const socials = SOCIALS.filter(s => s.HREF);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section class="space-y-6">
        <h1 class="animate text-2xl font-semibold text-black">
          Hi, I'm Liam.
        </h1>
        <article class="animate space-y-4">
          <p>
            I'm an engineer, curious about how systems work.
          </p>
          <p>
            Now I design them. Factories, collision centers, service centers,
            and used car hubs are each a small system, with material, people,
            and vehicles moving through a shared space. Before that, I worked on
            continuous improvement for another one: a truck assembly line. I
            have a master's degree in Industrial Engineering from Texas A&amp;M.
          </p>
          <p>
            This site keeps track of my career path, and it's where I write down
            what I learn along the way.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black">
            Writing
          </h2>
          {posts.length > 0 && (
            <Link href="/writing">
              All writing
            </Link>
          )}
        </div>
        {posts.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {posts.map(post => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm">The first essay is on its way.</p>
        )}
      </section>

      <section class="animate space-y-6">
        <h2 class="font-semibold text-black">
          Projects
        </h2>
        {PROJECTS.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {PROJECTS.map(project => (
              <li>
                {project.href ? (
                  <a href={project.href} target="_blank" rel="noopener noreferrer" class="block py-3 px-4 rounded-lg border border-black/15 hover:bg-black/5 hover:text-black transition-colors duration-300 ease-in-out">
                    <div class="font-semibold">{project.title}</div>
                    <div class="text-sm">{project.description}</div>
                  </a>
                ) : (
                  <div class="py-3 px-4 rounded-lg border border-black/15">
                    <div class="font-semibold">{project.title}</div>
                    <div class="text-sm">{project.description}</div>
                  </div>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm">Projects will show up here.</p>
        )}
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black">
            Resume
          </h2>
          <Link href="/resume">
            Full resume
          </Link>
        </div>
        <Timeline entries={TIMELINE} showSummary={false} />
      </section>

      {socials.length > 0 && (
        <section class="animate space-y-4">
          <h2 class="font-semibold text-black">
            Elsewhere
          </h2>
          <ul class="flex flex-wrap gap-2">
            {socials.map((SOCIAL, i) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                  {SOCIAL.NAME}
                </Link>
                {i < socials.length - 1 && "/"}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </Container>
</PageLayout>
