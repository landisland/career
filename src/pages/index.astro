---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import Timeline from "@components/Timeline.astro";
import StatusLine from "@components/StatusLine.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { TIMELINE } from "@data/timeline";

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const current = TIMELINE.find(e => e.current);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section class="space-y-6">
        <h1 class="animate text-2xl font-semibold text-black dark:text-white">
          Hi, I'm Liam.
        </h1>
        <div class="animate">
          <StatusLine entry={current} />
        </div>
        <article class="animate space-y-4">
          <p>
            I'm a manufacturing engineer. I design factory layouts: where the
            equipment goes, how parts move between stations, and how people and
            robots share the same floor.
          </p>
          <p>
            Before that I designed collision centers, service centers, and used
            car hubs, and before that I worked on continuous improvement on a
            truck assembly line. I studied industrial engineering at Beijing
            Jiaotong University and Texas A&amp;M.
          </p>
          <p>
            This site is where I write down what I learn about factories, in
            plain language.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Timeline
          </h2>
          <Link href="/resume">
            Full resume
          </Link>
        </div>
        <Timeline entries={TIMELINE} />
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Writing
          </h2>
          {posts.length > 0 && (
            <Link href="/writing">
              All writing
            </Link>
          )}
        </div>
        {posts.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {posts.map(post => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm">The first essay is on its way.</p>
        )}
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Elsewhere
        </h2>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map((SOCIAL, i) => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {i < SOCIALS.length - 1 && "/"}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
