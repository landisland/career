---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Timeline from "@components/Timeline.astro";
import { RESUME } from "@consts";
import { TIMELINE, EDUCATION } from "@data/timeline";

// Drop a PDF at public/resume.pdf and set this to true to show the download link.
const HAS_PDF = false;
---

<PageLayout title={RESUME.TITLE} description={RESUME.DESCRIPTION}>
  <Container>
    <div class="space-y-12">
      <div class="animate flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">
          Resume
        </h1>
        {HAS_PDF && (
          <a href="/resume.pdf" class="text-sm underline underline-offset-2">
            Download PDF
          </a>
        )}
      </div>

      <section class="animate space-y-6">
        <h2 class="font-semibold text-black dark:text-white">Experience</h2>
        <Timeline entries={TIMELINE} showHighlights />
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Education</h2>
        <ul class="space-y-3">
          {EDUCATION.map(e => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3">
              <div>
                <div class="font-semibold text-black dark:text-white">{e.school}</div>
                <div class="text-sm">{e.degree}</div>
              </div>
              <div class="text-sm tabular-nums">{e.period}</div>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-3">
        <h2 class="font-semibold text-black dark:text-white">Tools</h2>
        <p class="text-sm leading-relaxed">
          AutoCAD · Revit · FlexSim · SQL · Python · Power BI · Lean methods
          (5S, A3, FMEA, SLP)
        </p>
      </section>
    </div>
  </Container>
</PageLayout>
